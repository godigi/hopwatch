#!/usr/bin/env bash
# .githooks/pre-push — Automatically bumps version and tags if unreleased commits exist
set -euo pipefail

if [ "${NETDIAG_NO_BUMP:-0}" = "1" ]; then
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
LATEST_TAG="$(git describe --tags --abbrev=0 2>/dev/null || true)"

while read -r local_ref local_oid remote_ref remote_oid; do
    if [[ "$local_ref" =~ /(main|master)$ ]]; then
        if [ -n "$LATEST_TAG" ]; then
            UNRELEASED_COMMITS="$(git log "${LATEST_TAG}..HEAD" --oneline || true)"
        else
            UNRELEASED_COMMITS="$(git log --oneline || true)"
        fi

        # Check if there are unreleased commits that contain feat or fix
        if echo "$UNRELEASED_COMMITS" | grep -qE '^[0-9a-f]+ (feat|fix)(\([^\)]+\))?:'; then
            echo ""
            echo "🔔 [netdiag] Detected unreleased feature/fix commits since ${LATEST_TAG}:"
            echo "$UNRELEASED_COMMITS" | sed 's/^/   /'
            echo ""
            echo "🚀 Automatically bumping version and cutting release..."
            python3 "$REPO_ROOT/scripts/bump.py"
            echo ""
            echo "Pushing updated release commit and tags..."
            export NETDIAG_NO_BUMP=1
            git push origin main --tags
            exit 1
        fi
    fi
done

exit 0
